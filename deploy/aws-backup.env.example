# Copia este fichero como "aws-backup.env" (sin ".example") en esta misma carpeta,
# y rellena tus valores reales. Ese fichero NO se sube nunca a git.
# Si no existe "aws-backup.env", el backup a S3 simplemente no se activa.

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
NUTRICLINICA_S3_BUCKET=
NUTRICLINICA_S3_REGION=
NUTRICLINICA_S3_PREFIJO=
NUTRICLINICA_S3_INTERVALO_MIN=60
