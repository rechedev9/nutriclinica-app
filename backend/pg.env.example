# Copia este fichero como "pg.env" (sin ".example") en esta misma carpeta
# (backend/), y rellena tus valores reales. Ese fichero NO se sube nunca a git.
# Sirve para cargar la conexión a PostgreSQL/RDS al lanzar la app en local
# (go run ./cmd/nutriclinica, cmd/seed, cmd/migrate_to_postgres, etc.).

NUTRICLINICA_PG_HOST=nutriclinica-db.c9imq8ycacbi.eu-north-1.rds.amazonaws.com
NUTRICLINICA_PG_PORT=5432
NUTRICLINICA_PG_USER=postgres
NUTRICLINICA_PG_PASSWORD=
NUTRICLINICA_PG_DBNAME=nutriclinica
NUTRICLINICA_PG_SSLMODE=require
